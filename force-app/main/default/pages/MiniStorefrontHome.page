<apex:page showHeader="false"
           sidebar="false"
           docType="html-5.0"
           standardStylesheets="false"
           applyHtmlTag="false" controller="CloudCrazeProductTestController"
           applyBodyTag="false">

<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0"/>

    <title>My Product Store</title>
    <style>
    

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f4f6f9;
    color: #243040;
    line-height: 1.5;
}


.store-header {
    background: linear-gradient(135deg, #014486, #0176d3);
    color: white;
    padding: 25px 20px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.12);
}

.header-content {
    max-width: 1200px;
    margin: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
}

.store-title h1 {
    font-size: 28px;
    margin-bottom: 4px;
}

.store-title p {
    color: #eaf3fc;
    font-size: 14px;
}

#view-cart,
#back-to-store {
    padding: 12px 22px;
    background-color: white;
    color: #0176d3;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.2s ease,
                transform 0.2s ease;
}

#view-cart:hover,
#back-to-store:hover {
    background-color: #eaf3fc;
    transform: translateY(-2px);
}

/* =========================
   MAIN STORE CONTAINER
========================= */

.store-container {
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 20px;
}

.store-container h2 {
    font-size: 25px;
    margin-bottom: 25px;
    color: #181818;
}

/* =========================
   LOADING MESSAGE
========================= */

.loading {
    text-align: center;
    padding: 25px;
    color: #666;
    font-size: 16px;
}

/* =========================
   PRODUCT GRID
========================= */

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 25px;
}

/* =========================
   PRODUCT CARD
========================= */

.product-card {
    background-color: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 3px 15px rgba(0, 0, 0, 0.06);
    border: 1px solid #e8edf3;
    transition: transform 0.3s ease,
                box-shadow 0.3s ease;
}

.product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
}

/* =========================
   PRODUCT IMAGE
========================= */

.product-image {
    width: 100%;
    height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #f8fafc;
    overflow: hidden;
}

.product-image img {
    display: block;
    width: auto;
    height: auto;
    max-width: 85%;
    max-height: 85%;
    object-fit: contain;
    padding: 0;
    margin: auto;
}

/* =========================
   PRODUCT INFORMATION
========================= */

.product-info {
    padding: 22px;
}

.product-info h3 {
    font-size: 18px;
    margin-bottom: 12px;
    color: #181818;
}

.product-price {
    font-size: 22px;
    font-weight: bold;
    color: #0176d3;
    margin-bottom: 20px;
}

/* =========================
   ADD TO CART BUTTON
========================= */

.add-cart {
    width: 100%;
    padding: 13px;
    background-color: #0176d3;
    color: white;
    border: none;
    border-radius: 7px;
    cursor: pointer;
    font-size: 15px;
    font-weight: bold;
    transition: background-color 0.2s ease,
                transform 0.2s ease;
}

.add-cart:hover {
    background-color: #005fb2;
    transform: translateY(-2px);
}

/* =========================
   RESPONSIVE PRODUCT GRID
========================= */

@media (max-width: 1000px) {
    .product-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (max-width: 750px) {
    .product-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }
}

@media (max-width: 480px) {
    .header-content {
        align-items: flex-start;
        flex-direction: column;
    }

    .store-title h1 {
        font-size: 23px;
    }

    .store-container {
        margin: 25px auto;
        padding: 0 14px;
    }

    .store-container h2 {
        font-size: 21px;
    }

    .product-grid {
        grid-template-columns: 1fr;
        gap: 18px;
    }

    .product-image {
        height: 170px;
    }
}


    </style>
    <!-- CSS Static Resource will be added here -->
</head>

<body>

    <header class="store-header">
        <div class="header-content">
            <div class="store-title">
                <h1>My Product Store</h1>
                <p>Smart shopping starts here.</p>
            </div>

            <button id="view-cart">
                🛒 Cart (<span id="cart-count">0</span>)
            </button>
        </div>
    </header>

    <main class="store-container">
        <h2>Featured Products</h2>

        <p id="loading" class="loading">
            Loading Products....
        </p>

        <div class="product-grid" id="product-container"></div>
    </main>

    <script id="product-template"
            type="text/x-handlebars-template">

        {{#each products}}
        <div class="product-card">

            <div class="product-image">
               {{#if imageUrl}}
                <img src="{{imageUrl}}" alt="{{name}}" />
                {{else}}
                    <span>🛍️</span>
                {{/if}}
            </div>

            <div class="product-info">
                <h3>{{name}}</h3>

                <p class="product-price">₹{{price}}</p>

                <button class="add-cart" data-id="{{id}}">
                    Add to cart
                </button>
            </div>

        </div>
        {{/each}}

    </script>

    <!-- JavaScript Static Resources will be added here -->

    <!-- 1. Handlebars library -->
<script src="https://cdn.jsdelivr.net/npm/handlebars@4.7.8/dist/handlebars.min.js"></script>
<!-- 2. Salesforce Visualforce remoting -->
<apex:includeScript value="/soap/ajax/60.0/apex.js"/>

<script>
    const container = document.getElementById('product-container');
const loading = document.getElementById('loading');
let products = [];
const savedCart = JSON.parse(localStorage.getItem('cart') || '[]');
const cart = new Map(savedCart);
const source = document.getElementById('product-template').innerHTML;
const template = Handlebars.compile(source);


//navigate to carts page
const viewCartButton = document.getElementById('view-cart');
viewCartButton.addEventListener('click',function(){
    window.location.href = '/apex/MiniStorefrontCart';
})


window.addEventListener('pageshow', function() {
    const savedCart = JSON.parse(
        localStorage.getItem('cart') || '[]'
    );

    cart.clear();

    for (const [id, product] of savedCart) {
        cart.set(id, product);
    }

    updateCartCount();
});



function fetchProducts() {
    return new Promise(function(resolve, reject) {

        Visualforce.remoting.Manager.invokeAction(
            '{!$RemoteAction.CloudCrazeProductTestController.getProducts}',

            function(result, event) {

                if (event.status) {
                    resolve(result);
                } else {
                    reject(event.message);
                }

            }
        );

    });
}


async function loadProducts(){
    try {
        loading.textContent = 'Fetching the products'
        products = await fetchProducts();
        console.log('Products received:', products);
        const html = template({products})
        container.innerHTML = html;
        loading.style.display = 'none';
        
    } catch (error) {
         loading.textContent = "Unable to load products.";

        console.log(error);
    }
    


}
container.addEventListener('click', function(event){

    const button = event.target.closest('.add-cart');
  
    
    if (button && container.contains(button)) {
        const productId = button.dataset.id;
        const selectedProduct = products.find(function(product){
            return String(product.id) === productId;
        })
        if(!selectedProduct){
            return;
        }
        if(cart.has(productId)){
            const existingProduct = cart.get(productId);
            existingProduct.quantity++;
        }else{
            cart.set(productId, {
                name : selectedProduct.name,
                price: selectedProduct.price,
                imageUrl: selectedProduct.imageUrl,
                quantity : 1
            })
        }
        // console.log(`${productName} Add to Cart clicked!`);
        console.log(cart);
        saveToCart();
        updateCartCount()
    }


    // to iterate over the map
//     for (const [productId, product] of cart.entries()) {
//     console.log("ID:", productId);
//     console.log("Name:", product.name);
// }

})
loadProducts();

function saveToCart(){
        localStorage.setItem('cart', JSON.stringify([...cart]));

}
function updateCartCount(){
    let count = 0;
    for (const product of cart.values()){
        count += product.quantity;
    }

    document.getElementById('cart-count').textContent = count;
}

</script>

</body>
</html>

</apex:page>